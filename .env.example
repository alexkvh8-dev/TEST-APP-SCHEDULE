# =====================================================================
# Everything here has a free tier. Only ANTHROPIC_API_KEY costs money,
# and it is optional.
# =====================================================================

# ---- Supabase (free tier) — Project Settings > API Keys ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key: server-only. Used by the cron jobs to read all users.
# NEVER expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- AI (optional) ----
# Leave every key blank and the app still works: need/want sorting and
# summaries fall back to built-in rules that cost nothing.
#
# Recommended: a free Google Gemini key from https://aistudio.google.com/apikey
# (no credit card, generous free tier).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional and PAID — Anthropic has no free tier. Only used if GEMINI_API_KEY
# is empty, or if you set AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Force a provider: gemini | anthropic | rules. Leave blank to auto-detect.
AI_PROVIDER=

# ---- Web push (free) — generate with: npx web-push generate-vapid-keys ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# ---- Cron ----
# Any long random string: openssl rand -hex 32
# The cron endpoints require: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=generate-a-long-random-string

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
