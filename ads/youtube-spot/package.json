{
  "name": "youtube-spec-spot",
  "version": "1.0.0",
  "private": true,
  "description": "Unofficial 10-second spec ad for YouTube, built with Remotion.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "still": "node scripts/stills.mjs",
    "render": "remotion render src/index.ts YouTubeSpot out/master.mp4",
    "web": "bash scripts/encode_web.sh out/master.mp4 youtube-spot-10s.mp4 12",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/roboto-flex": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@remotion/cli": "4.0.535",
    "@remotion/fonts": "4.0.535",
    "remotion": "4.0.535",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "@types/react": "19.1.8",
    "typescript": "5.7.3"
  }
}
